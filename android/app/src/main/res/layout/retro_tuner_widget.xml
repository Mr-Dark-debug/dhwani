<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="@drawable/widget_container_bg"
    android:padding="4dp"
    android:baselineAligned="false">

    <!-- ============================================================= -->
    <!-- LEFT PANEL: Dark Skeuomorphic Tuner Panel                     -->
    <!-- ============================================================= -->
    <LinearLayout
        android:id="@+id/widget_left_panel"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:background="@drawable/widget_left_panel_bg"
        android:padding="8dp"
        android:gravity="center_horizontal">

        <!-- Frequency Card -->
        <LinearLayout
            android:id="@+id/widget_freq_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/widget_freq_card_bg"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp">

            <!-- Card Header: Band pill + NOW PLAYING -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tv_widget_band"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="FM"
                    android:textColor="#FFFFFF"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:background="@drawable/widget_band_pill_bg"
                    android:paddingStart="5dp"
                    android:paddingEnd="5dp"
                    android:paddingTop="1dp"
                    android:paddingBottom="1dp" />

                <TextView
                    android:id="@+id/tv_widget_station_num"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="1"
                    android:textColor="#1A3A50"
                    android:textSize="9sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_widget_now_playing_tag"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:text="NOW PLAYING"
                    android:textColor="#2C4E63"
                    android:textSize="8sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Card Body: Frequency + station title -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="2dp">

                <TextView
                    android:id="@+id/tv_widget_frequency"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="97.2"
                    android:textColor="#0D1B26"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:includeFontPadding="false" />

                <TextView
                    android:id="@+id/tv_widget_freq_unit"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=" MHz"
                    android:textColor="#1A3A50"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:paddingBottom="2dp" />

                <TextView
                    android:id="@+id/tv_widget_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="end|center_vertical"
                    android:text="Dhwani Radio"
                    android:textColor="#112233"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:maxLines="2"
                    android:ellipsize="end"
                    android:layout_marginStart="4dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Dial Track -->
        <FrameLayout
            android:id="@+id/widget_dial_track"
            android:layout_width="match_parent"
            android:layout_height="22dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/widget_dial_scale_bg"
            android:paddingStart="4dp"
            android:paddingEnd="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tv_dial_1"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="96"
                    android:textColor="#666666"
                    android:textSize="9sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_dial_2"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="97"
                    android:textColor="#AAAAAA"
                    android:textSize="9sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_dial_3"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="98"
                    android:textColor="#666666"
                    android:textSize="9sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_dial_4"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="99"
                    android:textColor="#555555"
                    android:textSize="9sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Red center needle -->
            <ImageView
                android:layout_width="2dp"
                android:layout_height="match_parent"
                android:layout_gravity="center_horizontal"
                android:background="@drawable/widget_red_needle"
                android:contentDescription="Tuner needle" />
        </FrameLayout>

        <!-- Bottom Mode Row: Star + FM·AM pill -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="6dp">

            <ImageView
                android:id="@+id/iv_widget_star"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_widget_star"
                android:contentDescription="Favorite" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:text="" />

            <TextView
                android:id="@+id/tv_widget_band_mode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="FM · AM"
                android:textColor="#777777"
                android:textSize="9sp"
                android:textStyle="bold"
                android:background="@drawable/widget_pill_bg"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:gravity="center" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:text="" />
        </LinearLayout>
    </LinearLayout>

    <!-- ============================================================= -->
    <!-- RIGHT PANEL: Light Controls Panel                             -->
    <!-- ============================================================= -->
    <LinearLayout
        android:id="@+id/widget_right_panel"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:background="@drawable/widget_right_panel_bg"
        android:padding="8dp">

        <!-- Top Area Row: Radio Area + Stereo badge -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <LinearLayout
                android:id="@+id/btn_widget_area"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/widget_chip_bg"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="AREA"
                    android:textColor="#777777"
                    android:textSize="8sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_widget_area"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:text="Global"
                    android:textColor="#222222"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:layout_marginStart="4dp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/ll_widget_stereo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/widget_chip_bg"
                android:paddingStart="5dp"
                android:paddingEnd="5dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp">

                <ImageView
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:src="@drawable/ic_widget_headphones"
                    android:contentDescription="Stereo" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="3dp"
                    android:text="STEREO"
                    android:textColor="#444444"
                    android:textSize="7sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Favorite Stations Chips -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="5dp">

            <LinearLayout
                android:id="@+id/btn_widget_fav1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/widget_chip_bg"
                android:paddingStart="5dp"
                android:paddingEnd="5dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp">

                <TextView
                    android:id="@+id/tv_widget_fav1_name"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Station 1"
                    android:textColor="#333333"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/tv_widget_fav1_freq"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="2dp"
                    android:text="95.7"
                    android:textColor="#111111"
                    android:textSize="9sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btn_widget_fav2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/widget_chip_bg"
                android:paddingStart="5dp"
                android:paddingEnd="5dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp">

                <TextView
                    android:id="@+id/tv_widget_fav2_name"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Station 2"
                    android:textColor="#333333"
                    android:textSize="9sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/tv_widget_fav2_freq"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="2dp"
                    android:text="107.5"
                    android:textColor="#111111"
                    android:textSize="9sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Transport Controls & Volume Knob -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="4dp">

            <ImageView
                android:id="@+id/btn_widget_prev"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_widget_skip_prev"
                android:contentDescription="Previous Station"
                android:padding="2dp" />

            <ImageView
                android:id="@+id/btn_widget_rewind"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_widget_rewind"
                android:contentDescription="Rewind"
                android:padding="2dp"
                android:layout_marginStart="2dp" />

            <!-- Primary Play / Pause Circle Button -->
            <ImageView
                android:id="@+id/btn_widget_play_pause"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:src="@drawable/ic_widget_play"
                android:background="@drawable/widget_circle_btn_bg"
                android:contentDescription="Play Pause"
                android:padding="6dp"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp" />

            <ImageView
                android:id="@+id/btn_widget_fast_forward"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_widget_fast_forward"
                android:contentDescription="Fast Forward"
                android:padding="2dp"
                android:layout_marginEnd="2dp" />

            <ImageView
                android:id="@+id/btn_widget_next"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_widget_skip_next"
                android:contentDescription="Next Station"
                android:padding="2dp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:text="" />

            <!-- Volume Dial Indicator -->
            <ImageView
                android:id="@+id/iv_widget_knob"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_widget_volume_knob"
                android:contentDescription="Volume" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
